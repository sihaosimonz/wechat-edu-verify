<view class="container">
  <view class="form">
    <input class="input"
      type="text"
      placeholder="{{ui.email_prompt}}"
      value="{{email}}"
      bindinput="onEmailInput"
    />
    <button type="primary" loading="{{sending}}" bindtap="sendCode">
      {{ui.send_code}}
    </button>
  </view>
</view>