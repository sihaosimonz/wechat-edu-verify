<view class="container">
  <block wx:if="{{status === 'loading' || loading}}">
    <text>{{ui.loading}}</text>
  </block>
  <block wx:elif="{{status === 'unverified'}}">
    <text>{{ui.not_verified}}</text>
    <button type="primary" bindtap="reverify">{{ui.reverify}}</button>
  </block>
  <block wx:elif="{{status === 'verified'}}">
    <view class="verified">
      <text>{{ui.verified_until}}: {{validUntil}}</text>
    </view>
    <block wx:if="{{loadingQr}}">
      <text>{{ui.loading_qr}}</text>
    </block>
    <block wx:elif="{{qrUrlWithCacheBust}}">
      <image class="qr" src="{{qrUrlWithCacheBust}}" mode="widthFix" />
    </block>
    <block wx:else>
      <text>{{ui.qr_unavailable}}</text>
    </block>
  </block>
</view>
